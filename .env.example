# Required for real signup, sign-in, public posts, and shared interactions.
# Missing settings leave visitors signed out; they never sign in as a demo user.
# Follow supabase/SETUP.md; run the complete supabase/schema.sql in its SQL editor,
# and copy the project URL and public anon/publishable key from API settings.
# These are public browser credentials; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
